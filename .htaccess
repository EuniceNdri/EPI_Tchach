# =============================================================
# .htaccess RACINE – Point d'entrée direct vers index.php
# =============================================================

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si la ressource demandée existe (fichier CSS, JS, image...), on la sert
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Sinon, on redirige tout vers index.php à la racine
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# Désactiver le listing des dossiers
Options -Indexes

# Encodage UTF-8 par défaut
AddDefaultCharset UTF-8
