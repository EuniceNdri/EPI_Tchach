# ===========================================
# .env – Variables d'environnement
# ===========================================
# ⚠️  NE JAMAIS POUSSER CE FICHIER SUR GITHUB !
#     Copier .env.example → .env et remplir vos valeurs
# ===========================================

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=forum_ecole
DB_USER=admin
DB_PASS=admin
# Remplacer selon besoin :
# DB_DSN=mysql:host=localhost;port=3306;dbname=forum_ecole;charset=utf8mb4

# Application
APP_NAME=EPI_Tchach
APP_URL=http://localhost/EPI_Tchach/public
APP_ENV=development
APP_DEBUG=true
