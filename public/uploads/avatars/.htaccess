Options -Indexes
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>
<IfModule mod_authz_core.c>
    <FilesMatch "\.(?:php[0-9]?|phtml|phar)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(?:php[0-9]?|phtml|phar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
