# ===========================================
# .gitignore – Fichiers à ignorer par Git
# ===========================================

# Fichiers d'environnement (IMPORTANT : ne jamais pousser .env)
.env
.env.local

# Fichiers système
.DS_Store
Thumbs.db

# IDE / Éditeurs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Dépendances
/vendor/
node_modules/

# Logs
*.log
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/.dev-sessions/

# Fichiers uploadés par les utilisateurs
/public/uploads/
!/public/uploads/
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/avatars/
/public/uploads/avatars/*
!/public/uploads/avatars/.htaccess
!/public/uploads/publications/
/public/uploads/publications/*
!/public/uploads/publications/images/
!/public/uploads/publications/documents/
!/public/uploads/temp/
!/public/uploads/publications/images/.gitkeep
!/public/uploads/publications/documents/.gitkeep
!/public/uploads/temp/.gitkeep
