# ===========================================
# .gitignore – Fichiers à ignorer par Git
# ===========================================

# Fichiers d'environnement (IMPORTANT : ne jamais pousser .env)
.env
.env.local

# Fichiers système
.DS_Store
Thumbs.db

# IDE / Éditeurs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Dépendances
/vendor/
node_modules/

# Logs
*.log

# Fichiers uploadés par les utilisateurs
/public/uploads/
!/public/uploads/
/public/uploads/*
!/public/uploads/.htaccess
